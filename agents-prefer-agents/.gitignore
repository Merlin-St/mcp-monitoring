# Override parent .gitignore (which ignores `lib/`, `logs/`, and `*.log`) so
# this subproject's source dirs and LaTeX build logs are tracked, while still
# ignoring its bulk PR data.

!lib/
!logs/
!paper/*.log
!paper/appendix/*.log

# Byte-compiled
__pycache__/
*.py[cod]

# Bulk PR + repo data (available in S3 — see README "Bulk PR data" section)
# s3://aisi-data-eu-west-2-prod/users/merlin-stein/agents-prefer-agents/data/
data/prs/
data/old_phase1/
data/criticality/
data/repos.top10k.json

# Empty/transient sample dir
data/sampled/

# Per-script logs (verbose, regenerable)
logs/
